{
  "manifest_version": 3,
  "name": "流程自动化助手 FlowPilot",
  "version": "1.0.0",
  "description": "记录网页操作流程，按步骤全自动执行；每一步等待页面反应（文字/元素/跳转），未按预期出现则终止本轮并从第一步重跑。",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "流程自动化助手"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
